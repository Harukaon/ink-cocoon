{
  "name": "ink-cocoon",
  "version": "0.1.0",
  "private": true,
  "description": "墨茧 InkCocoon — 一只由 RSI 驱动的自进化写作有机体",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute ink-cocoon-db --remote --file=./schema/schema.sql",
    "db:init:local": "wrangler d1 execute ink-cocoon-db --local --file=./schema/schema.sql",
    "genesis": "wrangler d1 execute ink-cocoon-db --remote --file=./schema/genesis.sql",
    "genesis:local": "wrangler d1 execute ink-cocoon-db --local --file=./schema/genesis.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}